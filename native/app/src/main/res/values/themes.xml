<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Edge to edge from the first frame, on the splash colour the Flutter
         app used; Compose draws everything else. -->
    <style name="Theme.Rafeeq" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/splash</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <color name="splash">#033736</color>
</resources>
