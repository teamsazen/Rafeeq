---
import Base from '../layouts/Base.astro';
import Shot from '../components/Shot.astro';
import StoreButtons from '../components/StoreButtons.astro';
import { site } from '../data/site';
import { readdirSync, existsSync } from 'node:fs';
import { playIcon, check, star } from '../data/icons';

// The feature guide: [id, tab title, screen, text, facts].
const features: [string, string, string, string, string[]][] = [
  ['home', 'Home', 'home', 'Open Rafeeq to the Hijri date, a live countdown to the next prayer under a sky that follows the time of day, and one-tap shortcuts to the Qur’an, Namaz, Qibla, the calendar, Allah’s Names and Ayah Pictures.', ['Next prayer countdown', 'Hijri date', 'Jumu’ah and Eid greetings']],
  ['quran', 'The Qur’an', 'reader', 'Every surah with its Arabic, an English or Urdu translation, and recitations from renowned qaris. Set the Arabic and the translation to their own sizes, and keep listening with the mini-player.', ['English and Urdu translations', 'Choice of reciter', 'Search and bookmarks']],
  ['prayer', 'Prayer times', 'prayer', 'Accurate times for your location, calculated on your phone, with an adhan or a gentle reminder for each salah. Rafeeq also shows the forbidden times around sunrise, noon and sunset, plus Suhoor and Iftar.', ['Works offline', 'Hanafi or Shafi Asr', 'Choice of calculation method']],
  ['qibla', 'Qibla', 'qibla', 'A real-time compass points you to the Kaaba in Makkah and tells you exactly how far to turn, from wherever you are.', ['Live compass', 'Turn left or right']],
  ['namaz', 'Namaz & Wudu', 'namaz', 'A complete guide to salah, from Takbeer to Tasleem, with the Arabic and its meaning, and a step-by-step Wudu guide before you begin. Made for new Muslims, children and anyone coming back.', ['Every step in Arabic', 'With its meaning', 'Wudu guide']],
  ['ayah', 'Ayah pictures', 'ayah', 'Turn any ayah into a clean picture with its Arabic and translation, in an English or Urdu layout, ready to save or send to the people you love.', ['Arabic and translation', 'Urdu layout']],
  ['hijri', 'Hijri calendar', 'hijri', 'The Islamic month at a glance next to the Gregorian dates, with a Hijri correction for your local moon sighting.', ['Hijri and Gregorian', 'Moon sighting correction']],
  ['names', 'Asma ul Husna', 'names', 'The 99 Beautiful Names of Allah, each with its meaning, to read and reflect upon.', ['99 Names', 'With meanings']],
  ['urdu', 'English & اردو', 'language', 'Every screen of Rafeeq is in English and Urdu, with Urdu set in proper Nastaleeq. Switch languages any time in Settings.', ['Full Urdu', 'Nastaleeq type']],
  ['theme', 'Light & dark', 'theme', 'Rafeeq follows your phone in light or dark, or keeps the theme you choose. This page does the same: every screenshot here matches your own setting.', ['Light, System, Dark']],
];

// The Play Store screenshots, made by npm run images from screens/store/.
const store = existsSync('public/img/store') ? readdirSync('public/img/store').filter((f) => /^\d+\.webp$/.test(f)).sort() : [];
---

<Base>
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero__grid">
      <div class="hero__text">
        <h1 id="hero-title">Your All In One Muslim Companion</h1>
        <p class="lead">The Qur’an, prayer times, Qibla and more, in one calm app. Free, with no ads, in English and Urdu.</p>
        <StoreButtons />
        <a class="watch" href="#qibla" data-play><span class="watch__icon" set:html={playIcon} />Watch the Qibla in action</a>
      </div>

      <figure class="fan" data-fan>
        <div class="fan__phone fan__phone--l" tabindex="0"><Shot kind="phones" name="prayer" sizes="(max-width: 40rem) 42vw, 300px" alt="Today’s prayer times for Jhelum with the forbidden times around sunrise, noon and sunset" /></div>
        <div class="fan__phone fan__phone--c" tabindex="0"><Shot kind="phones" name="home" eager sizes="(max-width: 40rem) 46vw, 320px" alt="The Rafeeq home screen: the Hijri date, a countdown to the next prayer under a sky that follows the time of day, and the Explore shortcuts" /></div>
        <div class="fan__phone fan__phone--r" tabindex="0"><Shot kind="phones" name="reader" sizes="(max-width: 40rem) 42vw, 300px" alt="Reading Surah Al-Baqarah in Arabic with its Urdu translation" /></div>
        <svg class="fan__star fan__star--a" viewBox="0 0 52 52" aria-hidden="true" set:html={star} />
        <svg class="fan__star fan__star--b" viewBox="0 0 52 52" aria-hidden="true" set:html={star} />
      </figure>
    </div>
  </section>

  <section class="section" id="features" aria-labelledby="features-title">
    <div class="container">
      <div class="head">
        <h2 id="features-title">Everything in the app</h2>
        <p>Each part of Rafeeq, and what it does. The screenshots follow your light or dark setting.</p>
      </div>
      <div class="guide" data-guide>
        <div class="guide__tabs" role="tablist" aria-label="App features" hidden>
          {features.map(([id, title], i) => <button type="button" role="tab" id={`t-${id}`} aria-controls={`f-${id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i ? -1 : 0}>{title}</button>)}
        </div>
        <div class="guide__panels">
          {features.map(([id, title, shot, text, facts]) => (
            <section class="panel card card--lattice" role="tabpanel" id={`f-${id}`} aria-labelledby={`t-${id}`}>
              <figure class="screen"><Shot kind="phones" name={shot} sizes="(max-width: 40rem) 70vw, 300px" alt={`${title} in the app`} /></figure>
              <div class="panel__text">
                <h3>{title}</h3>
                <p>{text}</p>
                <ul class="facts">{facts.map((f) => <li>{f}</li>)}</ul>
              </div>
            </section>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="qibla" aria-labelledby="qibla-title">
    <div class="container trailer">
      <div class="player card" data-player>
        <video preload="none" playsinline controls muted poster="/img/qibla/poster.webp" width="720" height="900" aria-label="Rafeeq's Qibla compass turning to face the Kaaba, 9 seconds, no sound">
          <source src="/img/qibla/qibla-720.mp4" type="video/mp4" />
        </video>
        <button class="player__start" type="button" aria-label="Play the 9-second Qibla video" hidden><span set:html={playIcon} /></button>
      </div>
      <div class="trailer__text">
        <h2 id="qibla-title">Which way is the Kaaba?</h2>
        <p class="lead">Turn until the Kaaba sits at the top, and you are facing the Qibla. Nine seconds, no sound.</p>
        <dl class="figures">
          <div><dt>Surahs, with translation</dt><dd>114</dd></div>
          <div><dt>Names of Allah</dt><dd>99</dd></div>
          <div><dt>Languages</dt><dd>2</dd></div>
          <div><dt>Ads, now and always</dt><dd>0</dd></div>
        </dl>
      </div>
    </div>
  </section>

  {store.length > 0 && (
    <section class="section" id="screenshots" aria-labelledby="store-title">
      <div class="container">
        <div class="head">
          <h2 id="store-title">On Google Play</h2>
          <p>The screenshots from Rafeeq’s Play Store listing. Scroll sideways to see them all.</p>
        </div>
      </div>
      <div class="container">
        <div class="strip" tabindex="0" role="group" aria-label={`Rafeeq on Google Play, ${store.length} screenshots`}>
          {store.map((f, i) => {
            const n = f.replace('.webp', '');
            return <img src={`/img/store/${n}-sm.webp`} srcset={`/img/store/${n}-sm.webp 1x, /img/store/${n}.webp 2x`} height="500" loading="lazy" decoding="async" alt={`Play Store screenshot ${i + 1} of ${store.length}`} />;
          })}
        </div>
      </div>
    </section>
  )}

  <section class="section" aria-labelledby="open-title">
    <div class="container">
      <div class="card card--lattice private">
        <div>
          <h2 id="open-title">Free, open, and made with care</h2>
          <div class="private__links">
            <a class="link" href={site.githubUrl} rel="noopener">See the code on GitHub</a>
            <a class="link" href={site.privacyUrl}>Read the privacy policy</a>
          </div>
        </div>
        <ul>
          <li><Fragment set:html={check} /><span>Free for everyone: no ads, no paywall, no premium tier.</span></li>
          <li><Fragment set:html={check} /><span>Open source, so anyone can see how it works.</span></li>
          <li><Fragment set:html={check} /><span>The Qur’an and prayer times work offline.</span></li>
          <li><Fragment set:html={check} /><span>Your location is used for prayer times and the Qibla.</span></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section" id="get" aria-labelledby="get-title">
    <div class="container">
      <div class="card card--lattice close">
        <div>
          <h2 id="get-title">Take Rafeeq with you</h2>
          <p class="lead">Free on Google Play. The iPhone app is on its way, In Sha Allah.</p>
          <StoreButtons />
        </div>
        <figure class="screen"><Shot kind="phones" name="recite" sizes="280px" alt="Reading Surah Al-Baqarah with its Urdu translation while Abdullah Basfar recites" /></figure>
      </div>
    </div>
  </section>

</Base>

<script>
  import '../scripts/landing';
</script>
