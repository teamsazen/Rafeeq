---
// An app screenshot in its Android phone frame (public/img/phones, from npm run
// images). The screenshots are in light mode; theme-dark is the dark one.
interface Props {
  name: string;
  alt: string;
  sizes: string;
  eager?: boolean;
  class?: string;
}
const { name, alt, sizes, eager = false, class: className } = Astro.props;
// Keep in sync with PHONE in scripts/images.mjs (1162×2468, scaled to 720 wide).
const [w, h, sw] = [720, 1529, 360];
---
<img class={className} src={`/img/phones/${name}.webp`} srcset={`/img/phones/${name}-sm.webp ${sw}w, /img/phones/${name}.webp ${w}w`} sizes={sizes}
  width={w} height={h} alt={alt} loading={eager ? undefined : 'lazy'} fetchpriority={eager ? 'high' : undefined} decoding="async" />
