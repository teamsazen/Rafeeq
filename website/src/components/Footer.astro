---
import { site } from '../data/site';
---
<footer class="footer">
  <div class="container footer__grid">
    <p>Built by two brothers, for the Ummah. Rafeeq is free, with no ads, and open source under the MIT License. &copy; {new Date().getFullYear()}.</p>
    <ul>
      <li><a href={site.privacyUrl}>Privacy</a></li>
      <li><a href={site.termsUrl}>Terms</a></li>
      <li><a href={site.githubUrl} rel="noopener">GitHub</a></li>
      <li><a href={`mailto:${site.email}`}>Email</a></li>
      <li><a href={site.playStoreUrl} rel="noopener">Google Play</a></li>
    </ul>
  </div>
</footer>
