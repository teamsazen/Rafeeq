---
// Floating glass pill (as on teamsazen.com): brand, section links, GitHub and Google Play.
import { nav, site } from '../data/site';
import { githubSvg, playSvg } from '../data/icons';
---
<header class="pill-wrap">
  <nav class="navpill" aria-label="Main">
    <a class="brand" href="/"><img src="/img/logo.png" width="32" height="32" alt="" />Rafeeq</a>
    <div class="nav">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </div>
    <div class="pill-end">
      <a class="icon-btn" href={site.githubUrl} rel="noopener" aria-label="Rafeeq on GitHub" title="Rafeeq on GitHub"><Fragment set:html={githubSvg} /></a>
      <a class="gp gp-nav" href={site.playStoreUrl} rel="noopener" aria-label="Get it on Google Play"><Fragment set:html={playSvg} /><span><small>Get it on</small><b>Google Play</b></span></a>
    </div>
  </nav>
</header>
